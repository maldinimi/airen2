# DEVELOPMENT — laptop NVIDIA RTX A6000 Laptop 16 GB VRAM (desain §2.1).
# Pakai: cp .env.dev .env && make setup && make up   → http://localhost:8080
# Prasyarat: Docker + NVIDIA Container Toolkit. Tanpa GPU? Gunakan .env.tiruan.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.dev.yml

PROFIL=dev
AI_MODE=nyata
WORKER_PROFIL=lengkap
EKSTRAKTOR=docling
WORKER_REPLIKA=1

# Model entry level: Qwen3-VL 8B Thinking, kuantisasi AWQ 4-bit (±6 GB). Qwen belum merilis AWQ resmi;
# dipakai kuantisasi komunitas (compressed-tensors W4A16, lisensi Apache-2.0 mengikuti model induk).
LLM_MODEL=cyankiwi/Qwen3-VL-8B-Thinking-AWQ-4bit
LLM_KONTEKS=32768
LLM_GPU_UTIL=0.70
LLM_MAKS_PARALEL=4
LLM_MAKS_TOKEN=8192
LLM_REASONING_PARSER=deepseek_r1
LLM_URL=http://llm:8000/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
KONTEKS_MAKS_KARAKTER=50000
ITEM_PARALEL=2

POSTGRES_USER=airen
POSTGRES_PASSWORD=airen
POSTGRES_DB=airen
DATABASE_URL=postgresql+psycopg://airen:airen@db:5432/airen

PORT_WEB=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD_AWAL=GantiSegera!2026
SEED_CONTOH=true
COOKIE_SECURE=false
LOG_LEVEL=INFO
MAKS_UKURAN_PDF_MB=100
