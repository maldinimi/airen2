# NODE AI production — server GPU sewaan NVIDIA H100 NVL 94 GB (desain §2.3–2.4).
# Pakai: cp .env.node-ai .env && make setup-ai && make up-ai
# Node hanya menjalankan worker + llm; database & file tetap di server instansi, diakses lewat WireGuard.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.node-ai.yml

PROFIL=prod
AI_MODE=nyata
WORKER_PROFIL=lengkap
EKSTRAKTOR=docling

# Model production: Qwen3-VL 32B Thinking BF16 (±66 GB). Ganti ke FP8 bila cache kurang: LLM_MODEL=Qwen/Qwen3-VL-32B-Thinking-FP8
LLM_MODEL=Qwen/Qwen3-VL-32B-Thinking
LLM_KONTEKS=65536
LLM_GPU_UTIL=0.85
LLM_MAKS_PARALEL=16
LLM_MAKS_TOKEN=16384
LLM_REASONING_PARSER=deepseek_r1
LLM_DTYPE=bfloat16
LLM_URL=http://llm:8000/v1
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
KONTEKS_MAKS_KARAKTER=120000
ITEM_PARALEL=12

# Alamat server instansi lewat terowongan WireGuard (10.66.0.1 = server aplikasi)
DATABASE_URL=postgresql+psycopg://airen:GANTI_DENGAN_PASSWORD_KUAT@10.66.0.1:5432/airen
API_INTERNAL_URL=http://10.66.0.1:8080
SUMBER_FILE=api
# Token dari menu Admin › Node AI (ditampilkan sekali saat node didaftarkan)
NODE_NAMA=gpu-h100-1
NODE_TOKEN=
LOG_LEVEL=INFO
