# PRODUCTION â€” SERVER APLIKASI instansi (web, api, db). Tanpa GPU.
# Node AI (worker + llm) berjalan di GPU sewaan H100 NVL dengan .env.node-ai (lihat docs/instalasi-offline.md).
# Bila server aplikasi sendiri memiliki GPU: tambahkan docker-compose.gpu.yml ke COMPOSE_FILE dan WORKER_REPLIKA=1.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

PROFIL=prod
AI_MODE=nyata
WORKER_PROFIL=lengkap
EKSTRAKTOR=docling
WORKER_REPLIKA=0

LLM_MODEL=Qwen/Qwen3-VL-32B-Thinking

# WAJIB diganti sebelum dipakai
POSTGRES_USER=airen
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT
POSTGRES_DB=airen
DATABASE_URL=postgresql+psycopg://airen:GANTI_DENGAN_PASSWORD_KUAT@db:5432/airen
ADMIN_USERNAME=admin
ADMIN_PASSWORD_AWAL=GANTI_DENGAN_PASSWORD_AWAL_ADMIN

# Port database dibuka HANYA pada antarmuka WireGuard agar node AI dapat terhubung (desain Â§2.4).
DB_BIND_WIREGUARD=10.66.0.1
PORT_WEB=8080
SEED_CONTOH=false
COOKIE_SECURE=true
LOG_LEVEL=INFO
MAKS_UKURAN_PDF_MB=100
